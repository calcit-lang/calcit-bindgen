package calcit:db@0.1.0;

interface types {
  variant db-param {
    bool-value(bool),
    bytes-value(list<u8>),
    float-value(f64),
    int-value(s64),
    null-value,
    text-value(string),
  }

  variant db-error {
    backend(string),
    capability-denied(string),
    constraint-violation(string),
    decode-error(string),
    invalid-query(string),
    timeout(string),
    tx-error(string),
    unsupported(string),
  }

  record db-exec-result {
    last-insert-id: option<s64>,
    rows-affected: u64,
  }

  record db-query-result {
    columns: list<string>,
    rows-json: string,
  }
}

interface sql {
  use types.{db-error, db-exec-result, db-param, db-query-result};

  query: func(sql: string, params: list<db-param>) -> result<db-query-result, db-error>;
  exec: func(sql: string, params: list<db-param>) -> result<db-exec-result, db-error>;
  tx-begin: func() -> result<u64, db-error>;
  tx-query: func(tx-id: u64, sql: string, params: list<db-param>) -> result<db-query-result, db-error>;
  tx-exec: func(tx-id: u64, sql: string, params: list<db-param>) -> result<db-exec-result, db-error>;
  tx-commit: func(tx-id: u64) -> result<_, db-error>;
  tx-rollback: func(tx-id: u64) -> result<_, db-error>;
}

interface kv {
  use types.{db-error};

  get: func(key: string) -> result<option<list<u8>>, db-error>;
  set: func(key: string, value: list<u8>, ttl-ms: option<u64>) -> result<_, db-error>;
  delete: func(key: string) -> result<bool, db-error>;
}

world http-service {
  include wasi:http/proxy@0.2.12;
  import sql;
  import kv;
}
